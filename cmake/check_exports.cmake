cmake_minimum_required(VERSION 3.28)

if(NOT DEFINED LIBRARY OR NOT EXISTS "${LIBRARY}")
    message(FATAL_ERROR "Export check requires an existing LIBRARY.")
endif()
if(NOT LIBRARY_KIND MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY)$")
    message(FATAL_ERROR "Unsupported library kind: ${LIBRARY_KIND}")
endif()
if(NOT FORMAT MATCHES "^(ELF|MACHO|PE)$")
    message(FATAL_ERROR "Unsupported object format: ${FORMAT}")
endif()

if(FORMAT STREQUAL "PE" AND LIBRARY_KIND STREQUAL "SHARED_LIBRARY")
    if(NOT OBJDUMP)
        message(FATAL_ERROR "A toolchain objdump is required for PE exports.")
    endif()
    execute_process(COMMAND "${OBJDUMP}" -p "${LIBRARY}"
        RESULT_VARIABLE result OUTPUT_VARIABLE listing ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "objdump failed: ${error}")
    endif()
    # Address/ordinal tables precede this heading and are not symbol names.
    string(FIND "${listing}" "[Ordinal/Name Pointer] Table" table_start)
    if(table_start LESS 0)
        message(FATAL_ERROR "Cannot locate the PE export-name table.")
    endif()
    string(SUBSTRING "${listing}" ${table_start} -1 listing)
    string(REPLACE "\n" ";" lines "${listing}")
    set(symbols)
    foreach(line IN LISTS lines)
        if(line MATCHES "^The ")
            break()
        endif()
        # Binutils 2.45 adds the base ordinal and hint before the name.
        if(line MATCHES "^[ \t]*\\[[ \t]*[0-9]+\\][ \t]+\\+base\\[[ \t]*[0-9]+\\][ \t]+[0-9A-Fa-f]+[ \t]+([^ \t\r]+)[ \t\r]*$")
            list(APPEND symbols "${CMAKE_MATCH_1}")
        elseif(line MATCHES "^[ \t]*\\[[ \t]*[0-9]+\\][ \t]+([^ \t\r]+)[ \t\r]*$")
            list(APPEND symbols "${CMAKE_MATCH_1}")
        elseif(line MATCHES "^[ \t]*\\[[ \t]*[0-9]+\\]")
            message(FATAL_ERROR "Cannot parse PE export entry: ${line}")
        endif()
    endforeach()
else()
    if(NOT NM)
        message(FATAL_ERROR "A toolchain nm is required for defined symbols.")
    endif()
    if(FORMAT STREQUAL "MACHO")
        set(arguments -g -U -P)
    else()
        set(arguments -g --defined-only -P)
    endif()
    if(FORMAT STREQUAL "ELF" AND LIBRARY_KIND STREQUAL "SHARED_LIBRARY")
        list(PREPEND arguments -D)
    endif()
    execute_process(COMMAND "${NM}" ${arguments} "${LIBRARY}"
        RESULT_VARIABLE result OUTPUT_VARIABLE listing ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "nm failed: ${error}")
    endif()
    string(REPLACE "\n" ";" lines "${listing}")
    set(symbols)
    foreach(line IN LISTS lines)
        if(line MATCHES "^([^ \t]+)[ \t]+[A-Za-z?][ \t]+")
            set(symbol "${CMAKE_MATCH_1}")
            if(FORMAT STREQUAL "MACHO")
                string(REGEX REPLACE "^_" "" symbol "${symbol}")
            endif()
            list(APPEND symbols "${symbol}")
        endif()
    endforeach()
endif()

if(NOT symbols)
    message(FATAL_ERROR "No defined exports found; cannot validate an empty listing.")
endif()
foreach(symbol IN LISTS symbols)
    if(NOT symbol MATCHES "^ovd_")
        message(FATAL_ERROR "Non-ovd export: ${symbol}")
    endif()
endforeach()
list(LENGTH symbols count)
message(STATUS "Export check: ${count} ovd_ symbols (${FORMAT}, ${LIBRARY_KIND})")
