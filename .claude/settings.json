{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "5"
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge --admin*)",
      "Bash(gh issue delete*)",
      "Bash(gh issue transfer*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo archive*)",
      "Bash(gh secret*)",
      "Bash(gh auth token*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push --tags*)",
      "Edit(//**/.claude/hooks/**)",
      "Edit(//**/.claude/settings.json)",
      "Edit(//**/.claude/settings.local.json)",
      "Read(~/.config/gh/hosts.yml)"
    ]
  },
  "disableAllHooks": false,
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh",
            "timeout": 20,
            "onFailure": "block",
            "statusMessage": "Checking repo rules"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ploop@claude-automata": true,
    "refine@claude-automata": true,
    "tx@claude-automata": true,
    "version-up-alert@claude-automata": true
  },
  "extraKnownMarketplaces": {
    "claude-automata": {
      "source": {
        "source": "github",
        "repo": "clomia/claude-automata"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": false,
  "autoCompactEnabled": true
}
